<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MessManagement.MVVM.Views.MessListPage"
             Title="All Mess"
             xmlns:icons="clr-namespace:MessManagement.MVVM.Models"
             BackgroundColor="{AppThemeBinding Light='#F7F8FA',Dark={StaticResource Black}}">
    <Grid>
        <Grid Padding="20" RowSpacing="24">
            <Border
            class="MessWizardCardStyle">
                <CollectionView x:Name="MessCollection" ItemsSource="{Binding Messes}" VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#CBD5E1" StrokeThickness="1" Padding="10" Margin="5"
                            BackgroundColor="{AppThemeBinding Light='#F1F5F9',Dark={StaticResource Gray400}}"
                            StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="8" Padding="0,6">

                                    <Label Text="{Binding MessName}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource Primary},Dark={StaticResource White} }"/>
                                    <Label Text="{Binding Description}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray400},Dark={StaticResource White} }"/>
                                    <BoxView HeightRequest="1"
                                         BackgroundColor="{AppThemeBinding Light=#dddddd,Dark={StaticResource White} }"
                                         Margin="0,4"/>
                                    <Grid ColumnDefinitions="1.5*,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="6">
                                        <Label Text="Total market cost:" 
                                           FontAttributes="Bold" 
                                           Grid.Row="0" Grid.Column="0"/>
                                        <Label Text="{Binding TotalMarketCost, StringFormat='{0:F2} Tk'}" 
                                           Grid.Row="0" Grid.Column="1"/>
                                        <Label Text="Total meals:" 
                                           FontAttributes="Bold" 
                                           Grid.Row="1" Grid.Column="0"/>
                                        <Label Text="{Binding TotalMeals, StringFormat='{0:F2} Tk'}" 
                                           Grid.Row="1" Grid.Column="1"/>
                                        <Label Text="Meal rate:" 
                                           FontAttributes="Bold" 
                                           Grid.Row="2" Grid.Column="0"/>
                                        <Label Text="{Binding MealRate, StringFormat='{0:F2} Tk'}" 
                                           Grid.Row="2" Grid.Column="1"/>
                                        <Label Text="Common bill per member:" 
                                           FontAttributes="Bold" 
                                           Grid.Row="3" Grid.Column="0"/>
                                        <Label Text="{Binding CommonBillPerMember, StringFormat='{0:F2} Tk'}" 
                                           Grid.Row="3" Grid.Column="1"/>
                                    </Grid>
                                    <Button Text="View and modify"
                                    FontAttributes="Bold"
                                    Command="{Binding BindingContext.ViewMessCommand, Source={x:Reference MessCollection}}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    FontSize="14">
                                        <Button.ImageSource>
                                            <FontImageSource Glyph="{x:Static icons:IconFont.Details}" 
                                        FontFamily="MaterialIcons"
                                                 Size="24"/>
                                        </Button.ImageSource>

                                    </Button>

                                    <Button Text="Delete"
                                    TextColor="Red"
                                    BackgroundColor="#FFF5F5"
                                    FontAttributes="Bold"
                                    Command="{Binding BindingContext.RemoveMessCommand, Source={x:Reference MessCollection}}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    FontSize="14"
                                    IsVisible="{Binding IsCreatedByCurrentUser}">
                                        <Button.ImageSource>
                                            <FontImageSource Glyph="{x:Static icons:IconFont.Delete}" 
                                            FontFamily="MaterialIcons"
                                                         Color="Red"
                                                     Size="24"/>
                                        </Button.ImageSource>
                                    </Button>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
            
        </Grid>
        <Grid BackgroundColor="#88000000" IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       Color="Black"
                       WidthRequest="50"
                       HeightRequest="50"/>
        </Grid>
    </Grid>

</ContentPage>