<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MessManagement.MVVM.Views.MessMemberEditorPopup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             CanBeDismissedByTappingOutsideOfPopup="True"
             BackgroundColor="{AppThemeBinding Light='#F7F8FA',Dark={StaticResource Black}}">
    <VerticalStackLayout Spacing="15" MinimumHeightRequest="300" MinimumWidthRequest="250">
        <!-- Header -->
        <Label Text="Edit Member Details"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center" />

        <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#555555}" />

        <!-- Name -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Name" FontAttributes="Bold" />
            <Entry Text="{Binding Member.Name}" Placeholder="Enter name" />
        </VerticalStackLayout>

        <!-- Email -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Email" FontAttributes="Bold" />
            <Entry Text="{Binding Member.Email}" Placeholder="Enter email" Keyboard="Email" />
        </VerticalStackLayout>

        <!-- Rent -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Rent" FontAttributes="Bold" />
            <Entry Text="{Binding Member.Rent}" Placeholder="Enter rent" Keyboard="Numeric" />
        </VerticalStackLayout>

        <!-- Role -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Role" FontAttributes="Bold" />
            <Picker Title="Role" SelectedItem="{Binding Member.Role}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Manager</x:String>
                        <x:String>Editor</x:String>
                        <x:String>Member</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </VerticalStackLayout>
            
        <!-- Buttons -->
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="Cancel"
                        Command="{Binding CancelMemberCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryButtonBg}, Dark={StaticResource SecondaryButtonBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryButtonText}, Dark={StaticResource SecondaryButtonTextDark}}"
                        CornerRadius="10"
                        WidthRequest="120" />

            <Button Text="Save"
                        Command="{Binding SaveMemberCommand}"
                        TextColor="{StaticResource PrimaryButtonText}"
                        CornerRadius="10"
                        WidthRequest="120" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</toolkit:Popup>