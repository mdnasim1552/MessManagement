<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MessManagement.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MessManagement"
    xmlns:views="clr-namespace:MessManagement.MVVM.Views"
    xmlns:icons="clr-namespace:MessManagement.MVVM.Models"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    Shell.FlyoutBehavior="Flyout"
    Shell.TitleColor="{AppThemeBinding Light=Black,Dark=white}"
    Shell.ForegroundColor="{AppThemeBinding Light=Black,Dark=white}"
    Title="MessManagement">
    <!-- 🔹 Custom Header -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="200">
            <BoxView Color="Black" Opacity="0.3"/>
            <Image Source="{Binding ProfileImage, Mode=TwoWay}" Aspect="AspectFill" Opacity="0.5" />
            <Grid VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    HeightRequest="80"
                    WidthRequest="80"
                    Stroke="White"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0"
                    StrokeShape="Ellipse">
                <Grid>
                    <Image x:Name="ProfileImage" Source="{Binding ProfileImage,Mode=TwoWay}" Aspect="AspectFill"/>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                       Color="Black"
                                       WidthRequest="50"
                                       HeightRequest="50"/>
                </Grid>
                
            </Border>
            <Grid HorizontalOptions="Center"
                  VerticalOptions="Center"
                  TranslationX="30"
                  TranslationY="30"
                  Scale=".7">
                <ImageButton Command="{Binding UploadProfilePictureCommand}"
                                     BackgroundColor="White"
                                     CornerRadius="22"
                                     BorderColor="LightGray"
                                     BorderWidth="1"
                                     Aspect="Center">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{x:Static m:MaterialSharp.Edit}"
                                 Color="Black"
                                 FontFamily="MaterialSharpFilled"
                                 Size="24"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
            
            <HorizontalStackLayout Grid.Row="1"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0">
                <Label Grid.Row="1" Text="{Binding FullName, Mode=TwoWay}"
                x:Name="FullName"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,10,0,0"
                FontAttributes="Bold"/>
               
            </HorizontalStackLayout>
            <!-- User Name -->
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Home">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="{x:Static m:MaterialSharp.Home}"
                FontFamily="MaterialSharpFilled"
                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                         Size="24"/>
        </FlyoutItem.Icon>
        <ShellContent
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>
    <FlyoutItem Title="Mess List">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="{x:Static m:MaterialSharp.List}"
            FontFamily="MaterialSharpFilled"
                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                     Size="24"/>
        </FlyoutItem.Icon>
        <ShellContent
        ContentTemplate="{DataTemplate views:MessListPage}"
        Route="MessListPage" />
    </FlyoutItem>

    <FlyoutItem Title="Create Mess">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="{x:Static m:MaterialSharp.Open_in_new}"
                FontFamily="MaterialSharpFilled"
                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                     Size="24"/>
        </FlyoutItem.Icon>
        <ShellContent
            ContentTemplate="{DataTemplate views:MessWizardPage}"
            Route="MessWizardPage" />
    </FlyoutItem>
    <FlyoutItem Title="Current Mess Details"
                Route="MessDetailsTabBar"
                FlyoutDisplayOptions="AsSingleItem"
                Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Black}}">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="{x:Static m:MaterialSharp.Details}"
                             FontFamily="MaterialSharpFilled"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                             Size="24"/>
        </FlyoutItem.Icon>
        <!-- Members Tab -->
        <Tab Title="Members" Route="MessMembersPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.User_attributes}"
                                 FontFamily="MaterialSharpFilled"
                                 Size="24"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MessMembersPage}"/>
        </Tab>

        <!-- Meals Tab -->
        <Tab Title="Meals" Route="MealsPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Food_bank}"
                                 FontFamily="MaterialSharpFilled"
                                 Size="24"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MealsPage}"/>
        </Tab>

        <!-- Bills Tab -->
        <Tab Title="Bills" Route="CommonBillPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Calculate}"
                                 FontFamily="MaterialSharpFilled"
                                 Size="24"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CommonBillPage}"/>
        </Tab>

        <!-- Costs Tab -->
        <Tab Title="Costs" Route="MarketCostsPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Event_note}"
                                 FontFamily="MaterialSharp"
                                 Size="24"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MarketCostsPage}"/>
        </Tab>

    </FlyoutItem>
    <FlyoutItem Title="Mess Details" Shell.FlyoutItemIsVisible="False"
            Route="MessDetailsTabBarList"
            FlyoutDisplayOptions="AsSingleItem"
            Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
            Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
            Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Black}}">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="{x:Static m:MaterialSharp.Details}"
                         FontFamily="MaterialSharpFilled"
                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                         Size="24"/>
        </FlyoutItem.Icon>
        <!-- Members Tab -->
        <Tab Title="Members" Route="MessMembersPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.User_attributes}"
                             FontFamily="MaterialSharpFilled"
                             Size="24"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MessMembersPage}"/>
        </Tab>

        <!-- Meals Tab -->
        <Tab Title="Meals" Route="MealsPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Food_bank}"
                             FontFamily="MaterialSharpFilled"
                             Size="24"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MealsPage}"/>
        </Tab>

        <!-- Bills Tab -->
        <Tab Title="Bills" Route="CommonBillPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Calculate}"
                             FontFamily="MaterialSharpFilled"
                             Size="24"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CommonBillPage}"/>
        </Tab>

        <!-- Costs Tab -->
        <Tab Title="Costs" Route="MarketCostsPage">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Event_note}"
                             FontFamily="MaterialSharp"
                             Size="24"
                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MarketCostsPage}"/>
        </Tab>

    </FlyoutItem>

    <!-- 🔹 Mess Details TabBar -->
