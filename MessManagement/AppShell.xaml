                <FontImageSource Glyph="{x:Static m:MaterialSharp.Food_bank}"
                      FontFamily="MaterialSharpFilled"
                      Size="24"
                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Bills" 
                      Route="CommonBillPage"
                      ContentTemplate="{DataTemplate views:CommonBillPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Calculate}"
                      FontFamily="MaterialSharpFilled"
                      Size="24"
                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Costs" 
              Route="MarketCostsPage"
              ContentTemplate="{DataTemplate views:MarketCostsPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static m:MaterialSharp.Event_note}"
              FontFamily="MaterialSharp"
              Size="24"
              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
