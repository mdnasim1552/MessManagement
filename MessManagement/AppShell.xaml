    <Shell.FlyoutFooter>
        <Grid Padding="10" >
            <!--Icon="{FontImageSource FontFamily=MaterialSharpFilled, Glyph={x:Static m:MaterialSharp.Expand_circle_down}}"-->
            <Button Text="Logout" Style="{StaticResource PrimaryButton}" StyleClass="FilledButton"
                Clicked="LogoutButton_Clicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static m:MaterialSharp.Logout}" 
                        FontFamily="MaterialSharpFilled"
                                 Size="24"/>
                </Button.ImageSource>
            </Button>
        </Grid>
    </Shell.FlyoutFooter>
</Shell>
